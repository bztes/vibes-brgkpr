# Directory for the database, SSH host keys, authorized_keys and the session socket
DATA_DIR=./data

# Directory below which repositories are created (<REPO_DIR>/<user>/<repo>)
REPO_DIR=./data/repos

# Optional: exact address opened in the browser when accessed directly over HTTP (e.g. http://192.168.1.10:3000); leave unset behind a reverse proxy with TLS
# ORIGIN=http://localhost:3000

# Optional: header with the real client address, logged for restic connections; only set behind a reverse proxy, otherwise clients can fake it
# ADDRESS_HEADER=x-forwarded-for

# Optional: user and group ID owning the files in DATA_DIR and REPO_DIR (default 1000)
# PUID=1000
# PGID=1000

# Optional: time zone (default UTC)
# TZ=Europe/Berlin
