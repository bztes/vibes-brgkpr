#!/usr/bin/python3 -I
"""
Forced SSH command generated by brgkpr. Changes into the repository root (so clients can use
URLs relative to it, e.g. ssh://borg@host/./<repo id>) and runs

    borg serve --umask=077 --restrict-to-repository=<repo> [--append-only] [--storage-quota=<quota>]

Usage:

    brgkpr-serve --root=PATH --repo=PATH --key=ID --notify=SOCKET [--append-only] [--quota=BYTES]

--root         directory the client's relative repository paths are resolved against
--repo         the only repository this key may access
--key          id of the SSH key, shown in the app
--append-only  the repository or this key is append-only
--quota        passed to borg as --storage-quota (computed by the app, see
               src/lib/server/backends/borg/ssh.ts)
--notify       unix socket of the app: the session is logged there until borg exits,
               afterwards the app rescans the repository (size, last backup)
"""

import json
import os
import signal
import socket
import subprocess
import sys
import uuid

BORG = '/usr/bin/borg'


def die(msg):
    print(f'brgkpr-serve: {msg}', file=sys.stderr)
    sys.exit(2)


def parse_args(argv):
    root = repo = key_id = quota = notify = None
    append_only = False
    for arg in argv:
        key, _, value = arg.partition('=')
        if key == '--root':
            root = os.path.realpath(value)
        elif key == '--repo':
            repo = os.path.realpath(value)
        elif key == '--key':
            key_id = value
        elif key == '--append-only':
            append_only = True
        elif key == '--quota':
            quota = int(value)
        elif key == '--notify':
            notify = value
        else:
            die(f'unknown option {key}')
    if root is None or repo is None or key_id is None or notify is None:
        die('--root, --repo, --key and --notify are required')
    return root, repo, key_id, append_only, quota, notify


def connect_app(sock_path, session):
    """
    Reports the session to the app, which logs it as open until the returned socket is
    closed and then rescans the repository. Returns None if the app can't be reached: the
    periodic scan catches up then.
    """
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(2)
        s.connect(sock_path)
        s.sendall((json.dumps(session) + '\n').encode())
        return s
    except OSError:
        s.close()
        return None


def still_connected(s):
    """The app never sends anything, so readable means it closed the socket (e.g. restarted)."""
    try:
        s.setblocking(False)
        return s.recv(1) != b''
    except BlockingIOError:
        return True
    except OSError:
        return False


def end_session(app, sock_path, session):
    """Closes the socket, which ends the session in the app."""
    # if the app restarted in the meantime, report the session again (same id) to end it
    if app is not None and not still_connected(app):
        app.close()
        app = None
    if app is None:
        app = connect_app(sock_path, session)
    if app is not None:
        app.close()


def run(args, repo, key_id, notify):
    """Runs borg serve as a child (instead of exec) so the app can see when it exits."""
    session = {
        'session': uuid.uuid4().hex,
        'repo': repo,
        'key': key_id,
        'client': os.environ.get('SSH_CONNECTION', '').split(' ')[0] or None,
    }
    app = connect_app(notify, session)
    child = subprocess.Popen(args, executable=BORG)

    # e.g. SIGHUP from sshd when the connection drops: pass it on to borg and keep waiting
    def forward(signum, _frame):
        child.send_signal(signum)

    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, forward)

    code = child.wait()
    code = code if code >= 0 else 128 - code
    end_session(app, notify, session)
    sys.exit(code)


def main():
    root, repo, key_id, append_only, quota, notify = parse_args(sys.argv[1:])
    try:
        os.chdir(root)
    except OSError as e:
        die(f'cannot change into {root}: {e.strerror}')
    args = ['borg', 'serve', '--umask=077', f'--restrict-to-repository={repo}']
    if append_only:
        args.append('--append-only')
    if quota is not None:
        args.append(f'--storage-quota={quota}')
    run(args, repo, key_id, notify)


if __name__ == '__main__':
    main()
