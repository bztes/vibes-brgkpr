# sshd for borg clients only. Access is controlled through the forced commands in
# /data/ssh/authorized_keys, which is generated by brgkpr.
Port 22
HostKey /data/ssh/host_keys/ssh_host_ed25519_key
HostKey /data/ssh/host_keys/ssh_host_rsa_key
PidFile /run/sshd.pid

AllowUsers borg
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile /data/ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
StrictModes yes

AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
PermitTunnel no
X11Forwarding no
PermitTTY no
PermitUserEnvironment no
PrintMotd no

# keep long running backups alive and drop dead connections
ClientAliveInterval 30
ClientAliveCountMax 10
LogLevel INFO
